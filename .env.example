# Copy this file to .env and fill it in. .env is ignored by git.
#
# Everything except the secrets (APP_TOKEN, HA_TOKEN, and the JSON key file) can also be changed
# later in the app: Settings → Server settings. Values saved there take precedence over this file;
# each one has a "Use .env value" link to switch back.

# The long ID in your Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
SPREADSHEET_ID=

# Your time zone, so "Today" in the app matches your day.
TZ=America/Chicago

# Optional extra password. If set, each phone enters it once in the app's Settings,
# and Home Assistant sends it too (see homeassistant/journeys.yaml).
# APP_TOKEN=

# ---- Home Assistant nudges (optional; all three needed to turn them on) ----
# Address the container can reach Home Assistant at. Use the IP; .local names often don't resolve inside Docker.
# HA_URL=http://192.168.1.10:8123
# Profile → Security → Long-lived access tokens → Create token
# HA_TOKEN=
# Your phone's notify service, without "notify." (Developer tools → Actions → search "mobile_app").
# Several phones: separate with commas.
# HA_NOTIFY=mobile_app_pixel_8

# Hour of the day for the daily check (24h, your TZ).
# NUDGE_HOUR=9
# Days on one step before nudging, used until your own history shows what's usual.
# NUDGE_AFTER_DAYS=7
# Days before asking about the same step again (also what "Still waiting" snoozes for).
# NUDGE_REPEAT_DAYS=3

# ---- Goals & habits add-on (optional; also a switch in the app: Settings → Add-ons) ----
# GOALS_ENABLED=false
# Hour for the evening habit check-in through Home Assistant (24h, your TZ).
# CHECKIN_HOUR=21
# Days without progress before a goal counts as stalled and gets a nudge.
# GOAL_STALL_DAYS=14
