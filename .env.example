# Copy this file to .env and fill it in. .env is ignored by git.

# The long ID in your Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
SPREADSHEET_ID=

# Your time zone, so "Today" in the app matches your day.
TZ=America/Chicago

# Optional extra password. If set, each phone enters it once in the app's Settings.
# APP_TOKEN=
