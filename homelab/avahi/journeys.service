<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Announces Journeys on your Wi-Fi so the Homebase app finds it (like Home Assistant).
     Copy to /etc/avahi/services/ on the Pi; Avahi picks it up by itself. -->
<service-group>
  <name replace-wildcards="yes">Journeys on %h</name>
  <service>
    <type>_homebase._tcp</type>
    <port>8080</port>
    <txt-record>app=journeys</txt-record>
    <txt-record>name=Journeys</txt-record>
  </service>
</service-group>
