<?xml version="1.0" encoding="utf-8"?>
<!-- Homelab servers are often plain http inside a tailnet (whose traffic WireGuard already encrypts),
     so plain http is allowed. Prefer https when your server has it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
